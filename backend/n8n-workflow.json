{
  "name": "ZEPHYR VALE — Full Autonomous Pipeline",
  "nodes": [
    {
      "id": "trigger-schedule",
      "name": "📅 Daily Content Trigger",
      "type": "n8n-nodes-base.cron",
      "parameters": {
        "triggerTimes": {
          "item": [
            { "mode": "custom", "cronExpression": "0 9 * * *",   "_comment": "9 AM daily — generate content" },
            { "mode": "custom", "cronExpression": "0 20 * * 1,3,5", "_comment": "Mon/Wed/Fri 8 PM — post time" }
          ]
        }
      },
      "position": [100, 300]
    },
    {
      "id": "creative-director",
      "name": "🎬 Creative Director Agent",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/luxury/agents/run",
        "method": "POST",
        "body": {
          "agent_name": "creative_director",
          "task": "Generate today's content brief based on seasonal calendar and trending aesthetics"
        }
      },
      "position": [300, 300]
    },
    {
      "id": "generate-full",
      "name": "✨ Full Content Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/luxury/create-full",
        "method": "POST",
        "body": {
          "content_type": "photo",
          "location": "Monaco Yacht Club",
          "outfit": "Dior Homme SS25 Suit",
          "mood": "Mysterious & Brooding",
          "lighting": "Golden hour natural"
        },
        "_comment": "In production: populate from Creative Director output"
      },
      "position": [500, 300]
    },
    {
      "id": "wait-approval",
      "name": "⏳ Wait for Telegram Approval",
      "type": "n8n-nodes-base.wait",
      "parameters": {
        "resume": "webhook",
        "webhookId": "zephyr-approval-webhook",
        "_comment": "Telegram bot calls this webhook on approve/reject"
      },
      "position": [700, 300]
    },
    {
      "id": "check-approved",
      "name": "✅ Approved?",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{$json.action}}", "operation": "equal", "value2": "approve" }]
        }
      },
      "position": [900, 300]
    },
    {
      "id": "schedule-post",
      "name": "📆 Schedule Instagram Post",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/luxury/schedule/add",
        "method": "POST",
        "queryParameters": {
          "content_id": "={{$json.content_id}}",
          "content_type": "={{$json.content_type}}",
          "media_url": "={{$json.image_url}}",
          "caption": "={{$json.caption}}"
        }
      },
      "position": [1100, 200]
    },
    {
      "id": "post-now",
      "name": "🚀 Post to Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/luxury/instagram/post",
        "method": "POST",
        "body": {
          "media_url": "={{$json.image_url}}",
          "caption": "={{$json.caption}} {{$json.hashtags}}",
          "content_type": "={{$json.content_type}}"
        }
      },
      "position": [1300, 200]
    },
    {
      "id": "analytics-check",
      "name": "📊 1-Hour Analytics Check",
      "type": "n8n-nodes-base.wait",
      "parameters": {
        "amount": 1,
        "unit": "hours"
      },
      "position": [1500, 200]
    },
    {
      "id": "fetch-analytics",
      "name": "📈 Fetch Post Performance",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/luxury/analytics/growth",
        "method": "GET"
      },
      "position": [1700, 200]
    },
    {
      "id": "analytics-agent",
      "name": "🧠 Analytics Agent Report",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/luxury/agents/run",
        "method": "POST",
        "body": {
          "agent_name": "analytics",
          "task": "Analyze post performance and update content strategy for next week"
        }
      },
      "position": [1900, 200]
    },
    {
      "id": "telegram-report",
      "name": "📱 Telegram Report",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "https://api.telegram.org/bot={{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "method": "POST",
        "body": {
          "chat_id": "={{$env.TELEGRAM_CHAT_ID}}",
          "text": "✦ *Post live!* Engagement: {{$json.engagement_rate}}% | Reach: {{$json.reach}}",
          "parse_mode": "Markdown"
        }
      },
      "position": [2100, 200]
    },
    {
      "id": "dm-reply-job",
      "name": "💬 DM Auto-Reply Job",
      "type": "n8n-nodes-base.cron",
      "parameters": {
        "triggerTimes": {
          "item": [{ "mode": "custom", "cronExpression": "*/15 * * * *", "_comment": "Every 15 min" }]
        }
      },
      "position": [100, 600]
    },
    {
      "id": "fetch-messages",
      "name": "📨 Fetch New DMs",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/luxury/instagram/messages",
        "method": "GET"
      },
      "position": [300, 600]
    },
    {
      "id": "caption-agent-dm",
      "name": "✍️ Generate DM Reply",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/luxury/agents/run",
        "method": "POST",
        "body": {
          "agent_name": "caption_storytelling",
          "task": "Write a luxury-toned DM reply for: {{$json.message_text}}"
        }
      },
      "position": [500, 600]
    },
    {
      "id": "weekly-analytics",
      "name": "📊 Weekly Analytics Report",
      "type": "n8n-nodes-base.cron",
      "parameters": {
        "triggerTimes": {
          "item": [{ "mode": "custom", "cronExpression": "0 9 * * 1", "_comment": "Every Monday 9 AM" }]
        }
      },
      "position": [100, 900]
    },
    {
      "id": "growth-agent-weekly",
      "name": "📈 Growth Agent Weekly",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/luxury/agents/run",
        "method": "POST",
        "body": {
          "agent_name": "instagram_growth",
          "task": "Analyze this week's performance and generate next week's content strategy"
        }
      },
      "position": [300, 900]
    }
  ],
  "connections": {
    "📅 Daily Content Trigger": {
      "main": [[{ "node": "🎬 Creative Director Agent", "type": "main", "index": 0 }]]
    },
    "🎬 Creative Director Agent": {
      "main": [[{ "node": "✨ Full Content Pipeline", "type": "main", "index": 0 }]]
    },
    "✨ Full Content Pipeline": {
      "main": [[{ "node": "⏳ Wait for Telegram Approval", "type": "main", "index": 0 }]]
    },
    "⏳ Wait for Telegram Approval": {
      "main": [[{ "node": "✅ Approved?", "type": "main", "index": 0 }]]
    },
    "✅ Approved?": {
      "main": [
        [{ "node": "📆 Schedule Instagram Post", "type": "main", "index": 0 }],
        []
      ]
    },
    "📆 Schedule Instagram Post": {
      "main": [[{ "node": "🚀 Post to Instagram", "type": "main", "index": 0 }]]
    },
    "🚀 Post to Instagram": {
      "main": [[{ "node": "📊 1-Hour Analytics Check", "type": "main", "index": 0 }]]
    },
    "📊 1-Hour Analytics Check": {
      "main": [[{ "node": "📈 Fetch Post Performance", "type": "main", "index": 0 }]]
    },
    "📈 Fetch Post Performance": {
      "main": [[{ "node": "🧠 Analytics Agent Report", "type": "main", "index": 0 }]]
    },
    "🧠 Analytics Agent Report": {
      "main": [[{ "node": "📱 Telegram Report", "type": "main", "index": 0 }]]
    },
    "💬 DM Auto-Reply Job": {
      "main": [[{ "node": "📨 Fetch New DMs", "type": "main", "index": 0 }]]
    },
    "📨 Fetch New DMs": {
      "main": [[{ "node": "✍️ Generate DM Reply", "type": "main", "index": 0 }]]
    },
    "📊 Weekly Analytics Report": {
      "main": [[{ "node": "📈 Growth Agent Weekly", "type": "main", "index": 0 }]]
    }
  },
  "_setup": {
    "env_vars": {
      "BACKEND_URL":        "http://localhost:8000",
      "TELEGRAM_BOT_TOKEN": "from .env",
      "TELEGRAM_CHAT_ID":   "from .env"
    },
    "import_steps": [
      "1. Open n8n (https://n8n.io or self-hosted)",
      "2. Click Import Workflow",
      "3. Paste this JSON",
      "4. Set environment variables in n8n settings",
      "5. Activate workflow"
    ]
  }
}
