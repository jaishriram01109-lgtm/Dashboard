# ─── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Backend ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://smartflow:smartflow@localhost:5432/smartflow
REDIS_URL=redis://localhost:6379

# ─── Market Data APIs ─────────────────────────────────────────
# NSE official: https://www.nseindia.com/developer/docs
NSE_API_KEY=your_nse_api_key_here

# Upstox (real-time tick data)
UPSTOX_API_KEY=your_upstox_key
UPSTOX_API_SECRET=your_upstox_secret
UPSTOX_ACCESS_TOKEN=your_access_token

# Zerodha Kite (institutional grade)
KITE_API_KEY=your_kite_key
KITE_API_SECRET=your_kite_secret

# AlphaVantage (global macro)
ALPHA_VANTAGE_KEY=your_alphavantage_key

# Screener.in (fundamental data)
SCREENER_API_KEY=your_screener_key

# ─── AI Engine ────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key

# ─── Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256

# ══════════════════════════════════════════════════════════════
# ✦  AI LUXURY MODEL SYSTEM — ZEPHYR VALE
# ══════════════════════════════════════════════════════════════

# ─── Claude AI (Agent Engine) ─────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ─── OpenAI (Fallback / Caption Agent) ────────────────────────
OPENAI_API_KEY=sk-your_openai_key_here

# ─── Image Generation ─────────────────────────────────────────
# Replicate API (FLUX.1-dev, SDXL, video generation)
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# Stability AI (SDXL alternative)
STABILITY_API_KEY=sk-your_stability_key_here

# ─── Instagram Graph API ──────────────────────────────────────
# Setup guide:
# 1. Create Facebook App at https://developers.facebook.com/
# 2. Add Instagram Graph API product
# 3. Get Instagram Business Account ID
# 4. Generate long-lived access token (60 days)
# 5. Permissions needed: instagram_basic, instagram_content_publish,
#    instagram_manage_comments, instagram_manage_messages, instagram_manage_insights

INSTAGRAM_USER_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ─── Cloud Storage (for generated images) ─────────────────────
# Images must be hosted publicly for Instagram API upload
# Use AWS S3 or Cloudflare R2 (recommended — cheaper)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=zephyrvale-content
AWS_REGION=ap-south-1

# Cloudflare R2 (alternative to S3)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=zephyrvale-content
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ─── ComfyUI (local FLUX/SDXL generation) ────────────────────
# Run ComfyUI locally: python main.py --port 8188
COMFYUI_URL=http://localhost:8188
COMFYUI_WORKFLOW_ID=zephyr-vale-flux-v1

# ─── Model Identity ───────────────────────────────────────────
LORA_MODEL_PATH=./lora_models/ZephyrBase-v4.safetensors
LORA_STRENGTH=0.85
GENERATION_STEPS=35
CFG_SCALE=7.5
CONSISTENCY_THRESHOLD=95.0

# ─── Telegram (Approval Notifications) ───────────────────────
# When content is ready for review, bot sends you a message
TELEGRAM_APPROVAL_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_APPROVAL_CHAT_ID=your_personal_chat_id
