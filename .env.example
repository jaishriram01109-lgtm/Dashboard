# ─── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Backend ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://smartflow:smartflow@localhost:5432/smartflow
REDIS_URL=redis://localhost:6379

# ─── Market Data APIs ─────────────────────────────────────────
# NSE official: https://www.nseindia.com/developer/docs
NSE_API_KEY=your_nse_api_key_here

# Upstox (real-time tick data)
UPSTOX_API_KEY=your_upstox_key
UPSTOX_API_SECRET=your_upstox_secret
UPSTOX_ACCESS_TOKEN=your_access_token

# Zerodha Kite (institutional grade)
KITE_API_KEY=your_kite_key
KITE_API_SECRET=your_kite_secret

# AlphaVantage (global macro)
ALPHA_VANTAGE_KEY=your_alphavantage_key

# Screener.in (fundamental data)
SCREENER_API_KEY=your_screener_key

# ─── AI Engine ────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key

# ─── Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
